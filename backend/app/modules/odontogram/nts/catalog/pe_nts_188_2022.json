{
  "norm_version": "pe_nts_188_2022",
  "norm_label": "NTS N.° 188-MINSA/DGIESP-2022",
  "country": "PE",
  "expected_rule_count": 38,
  "pending_decisions": [
    "NTS-04: when does a digital finding become 'registrado'? The norm forbids altering a registered finding (5.6) but defines no draft/finalized workflow, no electronic signature, and no procedure for correcting a material error.",
    "NTS-04: does 6.1.30 (arch_cardinality one_or_both) persist as one bi-arch finding or two related findings? The norm does not say.",
    "NTS-04: multi-segment ranges (6.1.31) need target groups; the grouping model is not designed here.",
    "NTS-04: the six clinician_defined_shape rules need a geometry channel per finding; no shape storage is designed here.",
    "Clinical review: rotation_sense (6.1.13), mobility_degree (6.1.19) and dde_type=FLUOROSIS (6.1.5) have no closed vocabulary in the norm."
  ],
  "global_rules": [
    {
      "key": "fdi_two_digit",
      "title": "Numeración FDI (Sistema Dígito Dos)",
      "summary": "Tooth numbering uses the two-digit FDI system accepted by the FDI and the WHO.",
      "source": { "page": 5, "section": "5.4" }
    },
    {
      "key": "finding_not_procedure",
      "title": "Sólo hallazgos observados, no procedimientos planificados",
      "summary": "The odontogram records only observed clinical findings. Procedures to be performed under the treatment plan belong to the Ficha Odonto-Estomatológica, not to the chart.",
      "source": { "page": 5, "section": "5.8" }
    },
    {
      "key": "registered_finding_is_unalterable",
      "title": "Inalterabilidad del hallazgo registrado",
      "summary": "Every registered clinical finding is unalterable: no amendments, no crossing out. The norm does not define when a digital finding becomes registered.",
      "source": { "page": 5, "section": "5.6" }
    },
    {
      "key": "new_odontogram_on_new_findings_or_reentry",
      "title": "Nuevo odontograma ante nuevos hallazgos o reingreso",
      "summary": "A new odontogram is produced when new findings appear, when the treatment plan ends, on judicial/personal request, and when the patient re-enters after the plan is completed.",
      "source": { "page": 5, "section": "5.10, 5.11" }
    },
    {
      "key": "red_blue_only",
      "title": "Semántica de color: sólo rojo y azul",
      "summary": "Blue marks a finding in good state or a non-pathological characteristic; red marks a bad state, a temporary one, or a pathological characteristic. No other colour may be used for findings.",
      "source": { "page": 5, "section": "5.12, 5.13" }
    },
    {
      "key": "especificaciones_item",
      "title": "Ítem Especificaciones",
      "summary": "Holds findings or additional clinical characteristics that cannot be recorded in the boxes (e.g. crown metal colour, temporary crown material, fluorosis classification).",
      "source": { "page": 5, "section": "5.14" }
    },
    {
      "key": "observaciones_item",
      "title": "Ítem Observaciones",
      "summary": "Describes findings not contemplated by the nomenclature.",
      "source": { "page": 5, "section": "5.15" }
    },
    {
      "key": "chart_printed_black",
      "title": "Gráfico impreso en negro",
      "summary": "The chart itself is unique and printed in black, minimum 0.5 cm squares with the root proportional. Red and blue belong exclusively to the findings.",
      "source": { "page": 5, "section": "5.17" }
    }
  ],
  "rules": [
    {
      "rule_id": "6.1.1",
      "ordinal": 1,
      "official_name": "Aparato ortodóntico fijo",
      "scope": "range",
      "range_grouping": "single_segment",
      "attributes": [
        {
          "name": "condition_state",
          "kind": "enum",
          "is_sigla": false,
          "values": [
            { "code": "good", "name": "Buen estado" },
            { "code": "bad", "name": "Mal estado" }
          ]
        }
      ],
      "render": {
        "color_semantics": "condition_dependent",
        "marks": [
          { "kind": "symbol", "params": { "shape": "square_with_cross", "at": "endpoints" } },
          { "kind": "connector", "params": { "style": "straight_line" } }
        ]
      },
      "geometry_input": { "mode": "standard_geometry", "constraints": ["apex_level"] },
      "source": { "page": 6, "section": "6.1.1" },
      "notes": "Exactly two endpoints ('uniendo ambos cuadrados'): one continuous span."
    },
    {
      "rule_id": "6.1.2",
      "ordinal": 2,
      "official_name": "Aparato ortodóntico removible",
      "scope": "arch",
      "arch_cardinality": "one",
